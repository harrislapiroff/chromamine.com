<div @raw="content" webc:nokeep></div>
<slot></slot>

<style webc:scoped="rich-text">
    a:visited:not(.button, .footnote-ref) {
        color: var(--color-link-visited);
    }

    p,
    ul,
    ol {
        margin-top: 0;
        margin-bottom: var(--line-height-base);
    }

    li {
        margin-bottom: calc(var(--line-height-base) / 2);
    }

    li::marker {
        color: var(--color-text-muted);
    }

    ul > li {
        list-style-type: "- ";
    }

    ul ul,
    ul ol,
    ol ul,
    ol ol {
        margin-left: 2ch;
        margin-top: var(--line-height-base);
    }

    strong {
        font-weight: var(--font-weight-bold);
    }

    em {
        font-style: italic;
    }

    img, video {
        max-width: 100%;
        height: auto;
    }

    hr {
        margin: 0;
        padding: 0;
        border: 0;
    }

    hr::before {
        content: "* * *";
        display: block;
        margin-bottom: var(--line-height-base);
        color: var(--color-text-muted);
    }

    h1::before,
    h2::before,
    h3::before,
    h4::before,
    h5::before {
        content: "§";
        display: block;
        width: 2ch;
        margin-left: -2ch;
        float: left;
        color: var(--color-text-muted);
        font-style: normal;
    }

    h3 {
        color: var(--color-text-striking);
        font-weight: var(--font-weight-bold);
    }

    h4 {
        font-style: italic;
    }

    h5 {
        color: var(--color-text-muted);
    }

    blockquote {
        margin-top: 0;
        margin-bottom: 0;
        margin-left: 4ch;
    }

    strong {
        font-weight: var(--font-weight-bold);
    }

    pre.shiki,
    pre.observablehq--md-pre {
        font-family: inherit;
        margin: calc(var(--line-height-base) / 2) -2ch !important;
        padding: calc(var(--line-height-base) / 2) 2ch !important;
        overflow-x: auto;
        /* Light mode: 5% darker than page background */
        background-color: color-mix(in lch, var(--color-background) 95%, black 5%) !important;
    }

    /* ```lang scroll -- set by transformerScroll in config/markdown.js */
    pre.shiki.scroll {
        --code-bg: color-mix(in lch, var(--color-background) 95%, black 5%);
        --scroll-hint-bg: color-mix(in lch, var(--color-background) 90%, black 10%);
        --scroll-shadow: rgb(0 0 0 / 0.15);
        max-height: calc(var(--scroll-lines) * var(--line-height-base));
        overflow-y: auto;
    }

    @media (prefers-color-scheme: dark) {
        pre.shiki.scroll {
            --code-bg: var(--shiki-dark-bg, var(--color-background-code));
            --scroll-hint-bg: color-mix(in lch, var(--shiki-dark-bg, var(--color-background-code)) 60%, black 40%);
            --scroll-shadow: rgb(0 0 0 / 0.6);
        }
    }

    /* "Scroll ↑" / "Scroll ↓" labels pinned to the block's top and bottom
     * edges (position: sticky), shown only while there is more code in that
     * direction. Their opacity runs on the block's own scroll position; a
     * block that doesn't overflow has no active scroll timeline, so the
     * labels stay at their hidden default. */
    @supports (animation-timeline: scroll()) {
        pre.shiki.scroll::before,
        pre.shiki.scroll::after {
            --hint-height: 1.75em;
            /* "Scroll ↓" is 8 characters plus 1ch of padding a side; the font
             * is monospaced, so the width is exact */
            --hint-width: 10ch;
            /* How far past the right padding the label sits (set on mobile) */
            --hint-shift: 0px;
            position: sticky;
            /* Pin horizontally too, at the label's resting spot, so it stays
             * put when long lines scroll sideways */
            left: calc(100% - var(--hint-width) - var(--hint-shift));
            display: block;
            box-sizing: border-box;
            width: var(--hint-width);
            height: var(--hint-height);
            margin-inline-start: auto;
            margin-inline-end: var(--hint-shift);
            padding: 0 1ch;
            text-align: center;
            font-size: 0.75em;
            line-height: var(--hint-height);
            background-color: var(--scroll-hint-bg);
            border-radius: 0.4rem;
            pointer-events: none;
            user-select: none;
            opacity: 0;
            animation-timeline: scroll(nearest block);
            animation-timing-function: linear;
            animation-fill-mode: both;
        }

        /* Take up no space: each label overlaps the code next to it */
        pre.shiki.scroll::before {
            content: "Scroll ↑" / "";
            top: 0;
            margin-bottom: calc(-1 * var(--hint-height));
            animation-name: scroll-hint-in;
            animation-range: 0 var(--line-height-base);
        }

        pre.shiki.scroll::after {
            content: "Scroll ↓" / "";
            bottom: 0;
            margin-top: calc(-1 * var(--hint-height));
            animation-name: scroll-hint-out;
            animation-range: calc(100% - var(--line-height-base)) 100%;
        }
    }

    @keyframes scroll-hint-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes scroll-hint-out {
        from { opacity: 1; }
        to { opacity: 0; }
    }

    /* Browsers without scroll-driven animations get scroll shadows instead:
     * a shadow pinned to each edge (attachment: scroll), hidden by a cover in
     * the block's own colour that rides along with the content (attachment:
     * local). At the top of the scroll range the top cover sits over the top
     * shadow; scroll down and it moves away. Likewise at the bottom. */
    @supports not (animation-timeline: scroll()) {
        pre.shiki.scroll {
            background:
                linear-gradient(var(--code-bg) 50%, transparent) center top / 100% var(--line-height-base) no-repeat local,
                linear-gradient(transparent, var(--code-bg) 50%) center bottom / 100% var(--line-height-base) no-repeat local,
                linear-gradient(var(--scroll-shadow), transparent) center top / 100% calc(var(--line-height-base) / 2) no-repeat scroll,
                linear-gradient(transparent, var(--scroll-shadow)) center bottom / 100% calc(var(--line-height-base) / 2) no-repeat scroll,
                var(--code-bg) !important;
        }
    }

    @media (max-width: 640px) {
        pre.shiki, pre.observablehq--md-pre {
            margin: calc(-1 * var(--line-height-base) / 2) calc(-1 * var(--page-padding)) calc(var(--line-height-base) / 2) !important;
            padding: calc(var(--line-height-base) / 2) var(--page-padding) !important;
        }

        /* Pull the scroll labels out of the wide page padding to sit 2ch from
         * the edge, as on desktop. They're set at 0.75em, so their ch is
         * three-quarters of the block's; dividing by 0.75 converts. */
        pre.shiki.scroll::before,
        pre.shiki.scroll::after {
            --hint-shift: calc((2ch - var(--page-padding)) / 0.75);
        }
    }

    /* ```lang title="file.js" -- set by transformerTitle in config/markdown.js.
     * The figure takes over the code block's bleed margins, and the caption
     * shares its padding so the title lines up with the code. */
    figure.code-block {
        margin: calc(var(--line-height-base) / 2) -2ch;
    }

    figure.code-block > figcaption {
        margin: 0;
        padding: calc(var(--line-height-base) / 2) 2ch;
        font-style: normal;
        font-weight: var(--font-weight-bold);
        /* A shade darker than the code block (95% / 5%) */
        background-color: color-mix(in lch, var(--color-background) 90%, black 10%);
    }

    figure.code-block > pre.shiki {
        margin: 0 !important;
    }

    .code-block-icon {
        display: inline-block;
        width: 2ch;
        vertical-align: top;
    }

    .code-block-icon svg {
        display: block;
        /* Leave a little of the 2ch as a gap before the title */
        width: 1.6ch;
        height: var(--line-height-base);
    }

    @media (max-width: 640px) {
        figure.code-block {
            margin: calc(-1 * var(--line-height-base) / 2) calc(-1 * var(--page-padding)) calc(var(--line-height-base) / 2);
        }

        figure.code-block > figcaption {
            padding: calc(var(--line-height-base) / 2) var(--page-padding);
        }
    }

    @media (prefers-color-scheme: dark) {
        figure.code-block > figcaption {
            /* --shiki-dark-bg is copied onto the figure by transformerTitle */
            background-color: color-mix(in lch, var(--shiki-dark-bg, var(--color-background-code)) 60%, black 40%);
        }
    }

    pre.shiki > code,
    pre.observablehq--md-pre,
    pre.observablehq--md-pre > code {
        font-family: inherit;
        /* No background for inner elements */
        background-color: transparent !important;
    }

    /* Keep the custom background for non-shiki code blocks */
    pre.observablehq--md-pre {
        background-color: var(--color-background-code) !important;
    }

    code {
        font-family: inherit;
        margin: 0 -0.25ch;
        padding: 0.25ch 0.25ch;
        background: var(--color-background-code);
        color: var(--color-foreground-code);
        border-radius: 0.4rem;
    }

    pre > code,
    pre > code.shiki,
    pre.shiki > code {
        margin: 0 !important;
        padding: 0 !important;
        /* No background for code inside pre blocks */
        background: none !important;
    }

    /* Shiki dark mode support */
    @media (prefers-color-scheme: dark) {
        pre.shiki {
            /* Use shiki's dark background */
            background-color: var(--shiki-dark-bg) !important;
        }

        .shiki,
        .shiki span {
            color: var(--shiki-dark) !important;
            /* Optional, if you also want font styles */
            font-style: var(--shiki-dark-font-style) !important;
            font-weight: var(--shiki-dark-font-weight) !important;
            text-decoration: var(--shiki-dark-text-decoration) !important;
        }
    }

    /* Highlighted lines in code blocks */
    .shiki .highlighted {
        display: inline-block;
        width: 100%;
        /* Light mode: subtle yellow/amber highlight */
        background-color: rgba(251, 191, 36, 0.25);
        margin: 0 -2ch;
        padding: 0 2ch;
    }

    .shiki .highlighted-word {
        display: inline-block;
        /* Light mode: subtle yellow/amber highlight */
        background-color: rgba(251, 191, 36, 0.5);
    }

    @media (prefers-color-scheme: dark) {
        .shiki .highlighted {
            /* Dark mode: subtle blue-gray highlight */
            background-color: rgba(148, 163, 184, 0.08);
        }

        .shiki .highlighted-word {
            /* Dark mode: subtle blue-gray highlight */
            background-color: rgba(148, 163, 184, 0.2);
        }
    }

    figure {
        display: block;
    }

    picture, video {
        display: block;
    }

    source,
    img {
        border-radius: 0.4rem;
    }

    @media (max-width: 640px) {
        picture {
            margin: 0 calc(-1 * var(--page-padding));
        }

        source,
        img {
            border-radius: 0;
        }
    }

    figcaption {
        font-style: italic;
        margin-top: calc(var(--line-height-base) / 2);
    }

    /* Footnotes
     *----------*/
    .footnotes::before {
        content: "Footnotes";
        display: block;
        color: var(--color-text-muted);
        margin-bottom: calc(var(--line-height-base) / 2);
    }

    .footnotes li {
        margin-bottom: calc(var(--line-height-base) / 2);
    }

    .footnotes li > *:last-child {
        margin-bottom: 0;
    }


    /* Labeled box mixin
     * See: https://chromamine.com/2025/07/mixins-with-vanilla-css/
     *------------------*/

    .update, .note, .dance-card {
        border: 0.1rem solid var(--color);
        color: var(--color);
        padding-top: calc(var(--line-height-base) / 2 - 0.1rem);
        padding-bottom: calc(var(--line-height-base) / 2 - 0.1rem);
        padding-right: calc(2ch - 0.1rem);
        padding-left: calc(2ch - 0.1rem);
        margin: var(--line-height-base) 0;
        border-radius: var(--border-radius-base);
        position: relative;

        &::before {
            display: block;
            content: var(--label);
            position: absolute;
            top: calc(-1 * var(--line-height-base) / 2);
            left: -1ch;
            font-size: 0.8em;
            text-transform: uppercase;
            background: var(--color-background);
            padding: 0 0.5ch;
        }

        & > :last-child {
            margin-bottom: 0;
        }
    }
    /* Markdown IT container
     *----------------------*/

    .update {
        --color: var(--color-update);
        --label: "Update";
    }

    .note {
        --color: var(--color-text-alert);
        --label: "Note";
    }

    /* Dance Card Shortcode
     *---------------------*/
    .dance-card {
        --color: var(--color-base);
        --label: "Dance";
        max-width: 50ch;
    }

    .dance-header {
        display: grid;
        grid-template-columns: 1fr 1fr;
        margin-bottom: calc(var(--line-height-base) / 2);
    }

    .dance-header .dance-title {
        grid-column: 1;
        font-weight: var(--font-weight-bold);
    }

    .dance-header .dance-formation {
        grid-column: 2;
        text-align: right;
    }

    .dance-header .dance-author {
        grid-column: 1;
        grid-row: 2;
        font-style: italic;
    }

    .dance-section {
        display: grid;
        grid-template-columns: 2ch 1fr;
        gap: 2ch;
        margin-bottom: calc(var(--line-height-base) / 2);
    }

    .dance-section .dance-section-label {
        grid-column: 1;
        text-align: right;
        font-weight: var(--font-weight-bold);
    }

    .dance-section .dance-section-lines {
        grid-column: 2;
    }

    .dance-notes {
        --dance-box-padding: 2ch;
        border-top: 0.1rem solid var(--color-base);
        position: relative;
        margin: 0 calc(-1 * var(--dance-box-padding));
        padding: calc(var(--line-height-base) - 1rem) var(--dance-box-padding) 0 var(--dance-box-padding);
    }

    .dance-notes::before {
        display: block;
        content: "Notes";
        position: absolute;
        top: calc(-1 * var(--line-height-base) / 2);
        left: var(--dance-box-padding);
        font-size: 0.8em;
        text-transform: uppercase;
        background: var(--color-background);
        padding: 0 0.5ch;
    }

    .dance-notes-label, .dance-notes-content, .dance-notes-content > p {
        display: inline;
    }

    .dance-notes-label {
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
    }

    .dance-notes-label::after {
        content: ": ";
    }

    /* Button
     *------*/

     .button {
        display: inline-block;
        border: 0.1rem solid var(--color-base);
        padding: calc(var(--line-height-base) / 2 - 0.1rem) calc(1ch * 2 - 0.1rem);
        color: var(--color-base);
    }

    .button:visited {
        color: var(--color-base);
    }

    .button:hover {
        background-color: var(--color-base);
        color: var(--color-background);
    }

    .button-download::after {
        content: ' ↓';
    }

    /* Footnotes
     *----------*/

     .footnote-ref--interactive {
        width: 3.5ch;
        margin: -0.1rem calc(0.25ch - 0.1rem);
        height: 1em;
        line-height: 1em;
        display: inline-block;
        vertical-align: middle;
        border-radius: 0.4rem;
        text-align: center;
        border: 0.1rem solid var(--color-base);
        color: var(--color-base);
    }

    .footnote-ref--interactive:visited {
        color: var(--color-base);
    }

    .footnote-ref--interactive:hover {
        text-decoration: none;
        color: var(--color-background);
        background-color: var(--color-base);
    }

    .footnote-ref--interactive::after {
        display: inline-block;
        content: '•••';
        font-weight: normal;
        transition: transform 0.2s ease;
        height: 1em;
    }

    .footnote-ref--active {
        background-color: var(--color-base);
        border-radius: 0.4rem 0.4rem 0 0;
        color: var(--color-background) !important;
    }

    /* STL Viewer
     *-----------*/
    .stl-viewer {
        position: relative;
    }

    .stl-viewer__actions {
        display: inline-flex;
        position: absolute;
        top: var(--line-height-base);
        right: 0;
    }

    @media (max-width: 640px) {
        .stl-viewer__actions {
            right: var(--page-padding);
        }
    }

    .stl-viewer__action, a.stl-viewer__action {
        --border-radius: 0.4rem;
        background: transparent;
        color: var(--color-base);
        border: 1px solid var(--color-base);
        border-left: 0;
        padding: 0;
        margin: 0;
        font: inherit;
        cursor: pointer;
        outline: inherit;
        display: block;
        width: 1.5em;
        height: var(--line-height-base);
        line-height: calc(var(--line-height-base) - 0.2rem);
        box-sizing: border-box;
        text-align: center;
        text-decoration: none;
    }

    .stl-viewer__action:first-child, a.stl-viewer__action:first-child {
        border-left: 1px solid var(--color-base);
        border-top-left-radius: var(--border-radius);
        border-bottom-left-radius: var(--border-radius);
    }

    .stl-viewer__action:last-child, a.stl-viewer__action:last-child {
        border-top-right-radius: var(--border-radius);
        border-bottom-right-radius: var(--border-radius);
    }

    .stl-viewer__action:visited, a.stl-viewer__action:visited {
        color: var(--color-base);
    }

    .stl-viewer__action:hover, a.stl-viewer__action:hover {
        background: var(--color-link-hover);
        border-color: var(--color-link-hover);
        color: var(--color-background);
        text-decoration: none;
    }

    /* Image Grid
    *-----------*/
    .image-grid {
        display: flex;
        margin: 0 -1ch;
        align-items: center;
    }

    @media (max-width: 640px) {
        .image-grid {
            flex-direction: column;
        }
    }

    .image-grid__item {
        padding: 0 1ch;
    }
</style>

<!---
unscoped styles for footnotes which are hoisted out of the rich text element
by javascript
--->
<style>
    .footnote-popover {
        perspective: 20rem;
        position: absolute;
        top: 0;
        background: var(--color-background);
        border: 0.1rem solid var(--color-base);
        padding: calc(var(--line-height-base) / 2) calc(2ch - 0.1rem);
        max-width: 30ch;
        transform-origin: 50% 0;
        transition: opacity 0.35s ease-out;
        opacity: 0;
        pointer-events: none;
    }

    .footnote-popover :first-child {
        margin-top: 0;
    }

    .footnote-popover :last-child {
        margin-bottom: 0;
    }

    .footnote-popover--active {
        opacity: 1;
        display: block;
        pointer-events: auto;
    }
</style>
