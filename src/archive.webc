---
layout: page.webc
title: Archive
---

<script webc:setup>
    const slugify = str => str.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '')

    // These are functions, called from the template below, rather than
    // values: webc:setup runs once per component and its result is kept for
    // the life of `eleventy --serve`, so values computed here would show the
    // collections as they were when the server started.
    const getTags = collections => Object.keys(collections)
        .filter(t => !['all', 'posts', 'danceEvents'].includes(t))
        .sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase()))
        .map(t => ({
            name: t,
            count: collections[t].length,
            url: `/tags/${slugify(t)}/`,
        }))

    const getPosts = collections => collections.posts
        // Quirk: Trying to merge p with p.data completely like so:
        //
        //     .map(p => ({ ...p, ...p.data, date: new Date(p.date) }))
        //
        // causes first build to fail for some reason. Instead, we do a
        // more targeted merge, but specifying the attributes we need to
        // copy.
        .map(p => ({ ...p.data, url: p.url, date: new Date(p.date) }))
        .sort((a, b) => b.date - a.date)
</script>

<archive-interface :@tags="getTags($data.collections)" :@posts="getPosts($data.collections)"></archive-interface>
